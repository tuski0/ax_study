   "source": [
    "- jupyter Notebook에서는 이벤트 루프가 가동중 -> await 함수명()\n",
    "- 파이썬 파일을 실행할 때는 이벤트 루프를 생성해야 정상 동작\n",
    "\n",
    "```\n",
    "asyncio.run(...) \n",
    "```"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "0acba8da",
   "metadata": {},
   "outputs": [],
   "source": [
    "import asyncio\n",
    "\n",
    "async def work() :\n",
    "    await asyncio.sleep(2)\n",
    "    print('작업 완료')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "d6d3508b",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "작업 완료\n"
     ]
    }
   ],
   "source": [
    "await work()"
   ]
  }
 ],
